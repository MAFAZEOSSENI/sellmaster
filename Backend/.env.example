DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?sslmode=require&pgbouncer=true

# Firebase Admin service account JSON as one line; obtain it from Firebase project settings.
# Keep this secret out of source control. The whole service-account object belongs in this value.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":"your-client-id","token_uri":"https://oauth2.googleapis.com/token"}

JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
SHOPIFY_SCOPES=read_orders,write_orders,read_products,write_products,read_customers,read_inventory
# Use the existing Partner app's client ID; keep this callback aligned with its CLI config.
SHOPIFY_CLIENT_ID=your_existing_shopify_partner_app_client_id
SHOPIFY_REDIRECT_URI=https://sellmaster-1.onrender.com/api/shopify/auth/callback
SHOPIFY_FRONTEND_URL=https://www.sellmaster.site/

# AI Page Builder — Google Gemini
AI_PROVIDER=gemini
GOOGLE_AI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
AI_IMAGE_GENERATION_ENABLED=true
AI_MAX_IMAGES_PER_PAGE=8
AI_MAX_IMAGE_VARIANTS=4
PAGE_BUILDER_PUBLIC_URL=https://www.sellmaster.site
{
  "manifest_version": 3,
  "name": "Sellmaster Shopify Connector",
  "version": "1.0.0",
  "description": "Connectez Shopify à Sellmaster et configurez l’autorisation OAuth depuis l’administration Shopify.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sellmaster-1.onrender.com/*"
  ],
  "action": {
    "default_title": "Sellmaster",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://admin.shopify.com/store/*",
        "*://*.myshopify.com/admin*"
      ],
      "js": ["panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://dev.shopify.com/dashboard/*"],
      "js": ["selectors.js", "app-setup.js"],
      "run_at": "document_idle"
    }
  ]
}
